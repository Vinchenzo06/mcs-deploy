# =============================================================================
#  MCS - Réglages de la plateforme (OPTIONNEL)
#
#  Ce fichier n'a PAS besoin d'être modifié : sans lui, les valeurs par défaut
#  ci-dessous sont utilisées. Il ne contient que des réglages communs à toute
#  la plateforme, jamais des infos propres à une machine ou à une personne.
#  Emplacement sur le VPS : /etc/mcs/mcs.env
# =============================================================================

TIMEZONE=America/Toronto

# --- Versions -----------------------------------------------------------------
# Version du lobby : doit correspondre à l'API Paper utilisée par le plugin lobby
PAPER_VERSION=26.1.2
# "latest" ou une version précise (ex: 3.5.0-SNAPSHOT)
VELOCITY_VERSION=latest
# true = retélécharge Paper/Velocity même s'ils sont déjà présents
FORCE_UPDATE=false

# --- Mémoire JVM (VPS 4 Go) ----------------------------------------------------
API_XMX=384M
VELOCITY_XMX=512M
LOBBY_XMX=512M

# --- Réseau ---------------------------------------------------------------------
# Plage de ports des serveurs joueurs (doit correspondre à application.yml de l'API)
PORT_START=25600
PORT_END=25620

# Port public du VPS qui relaie vers le SSH d'une machine volontaire
# (le port SSH de la machine elle-même est détecté automatiquement chez elle)
ENABLE_SSH_TUNNEL=true
SSH_TUNNEL_PORT=2222

# --- Quotas par groupe LuckPerms : "serveurs RAM_Mo vCPU" ------------------------
QUOTA_DEFAULT="1 6144 2"
QUOTA_VIP="2 12288 4"
QUOTA_PREMIUM="2 16384 5"
QUOTA_ADMIN="16 32768 32"
