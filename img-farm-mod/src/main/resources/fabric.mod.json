    "client": ["vinch.img.farmmod.ImgFarmMod"]
  },
  "depends": {
    "fabricloader": ">=${loader_min}",
    "minecraft": ">=${minecraft_min}",
    "java": ">=25",
    "fabric-api": "*"
  }
